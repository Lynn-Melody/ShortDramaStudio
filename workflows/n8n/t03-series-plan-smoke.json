    {
      "parameters": {
        "jsCode": "const acceptance = $('Accept').first().json;\nif (acceptance.status !== 'accepted') return [];\nif (acceptance.input.idea !== 'A ghost train returns.') {\n  throw new Error('Expected the fixed T03 smoke test input');\n}\nconst { projectId, taskId, executionId, schemaVersion } = $('Dispatch').first().json.body;\nconst result = {\n  \"data\": {\n    \"title\": \"Night Service\",\n    \"world\": \"An abandoned subway line reopens after midnight.\",\n    \"visualGuide\": \"Cool fluorescent light and fixed camera.\",\n    \"characters\": [\n      {\n        \"name\": \"Mei\",\n        \"profile\": \"A pragmatic transit engineer who investigates unexplained events.\"\n      }\n    ],\n    \"episodes\": [\n      {\n        \"title\": \"Last Train\",\n        \"outline\": \"Mei discovers a train that should not exist.\"\n      }\n    ],\n    \"assets\": [\n      {\n        \"assetKey\": \"station\",\n        \"kind\": \"scene\",\n        \"title\": \"Station\",\n        \"description\": \"A quiet underground station\"\n      },\n      {\n        \"assetKey\": \"mei\",\n        \"kind\": \"character\",\n        \"title\": \"Mei\",\n        \"description\": \"Transit engineer in a grey jacket\"\n      },\n      {\n        \"assetKey\": \"pass\",\n        \"kind\": \"prop\",\n        \"title\": \"Transit pass\",\n        \"description\": \"Worn green card\"\n      }\n    ]\n  },\n  \"outputs\": []\n};\nreturn [{ json: { projectId, taskId, executionId, schemaVersion, outcome: 'completed', ...result } }];"
      },
